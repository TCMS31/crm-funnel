<%= simple_form_for deal, html: { class: "deal form" } do |f| %>
  <%= form_error_notification(deal) %>

  <%= f.association :user, label: "Contact", collection: User.recent.limit(200),
                    label_method: :full_name, value_method: :id, include_blank: "—" %>
  <%= f.association :company, collection: Company.recent.limit(200),
                    label_method: :name, value_method: :id, include_blank: "—" %>
  <%= f.input :probability, as: :integer, input_html: { min: 0, max: 100, value: deal.probability } %>

  <div class="input select">
    <%= label_tag "deal_stage", "Opening stage", class: "form__label" %>
    <%= select_tag "deal[stage]",
                   options_for_select(DealHistory.stage_names, params.dig(:deal, :stage) || Crm::DealOpener::DEFAULT_STAGE),
                   id: "deal_stage" %>
  </div>

  <div class="header__actions">
    <%= link_to "Cancel", deals_path, class: "btn btn--light" %>
    <%= f.submit "Open deal", class: "btn btn--secondary" %>
  </div>
<% end %>
