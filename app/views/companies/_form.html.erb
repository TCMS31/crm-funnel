<%= simple_form_for company, html: { class: "company form" } do |f| %>
  <%= form_error_notification(company) %>
  <%= f.input :name, input_html: { autofocus: true } %>
  <div class="header__actions">
    <%= link_to "Cancel", companies_path, class: "btn btn--light" %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
