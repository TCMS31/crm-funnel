<tr class="data-table__row">
  <td data-label="Name"><%= company.name %></td>
  <td data-label="Contacts" class="data-table__numeric"><%= company.users_count %></td>
  <td data-label="Deals" class="data-table__numeric"><%= company.deals_count %></td>
  <td class="data-table__actions">
    <%= link_to "Edit", edit_company_path(company), class: "btn btn--light", aria: { label: "Edit #{company.name}" } %>
    <%= button_to "Delete", company_path(company), method: :delete, class: "btn btn--quiet",
                  aria: { label: "Delete #{company.name}" },
                  form: { data: { turbo_confirm: "Delete #{company.name}?" } } %>
  </td>
</tr>
