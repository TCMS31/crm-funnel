<% content_for :title, "Companies — CRM Funnel" %>
<main class="container">
  <%= link_to sanitize("&larr; Back to funnel"), root_path, class: "breadcrumb" %>

  <div class="header">
    <div>
      <h1>Companies</h1>
      <p class="header__subtitle">
        <%= number_with_delimiter @companies.total_count %> companies ·
        page <%= @companies.current_page %> of <%= @companies.total_pages %>
      </p>
    </div>
    <div class="header__actions">
      <%= link_to "New company", new_company_path, class: "btn btn--primary" %>
    </div>
  </div>

  <% if @companies.empty? %>
    <%= render "companies/empty_state" %>
  <% else %>
    <div class="card">
      <table class="data-table data-table--companies">
        <caption class="visually-hidden">Companies, newest first</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col" class="data-table__numeric">Contacts</th>
            <th scope="col" class="data-table__numeric">Deals</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= render @companies %>
        </tbody>
      </table>
    </div>
    <%= paginate @companies %>
  <% end %>
</main>
