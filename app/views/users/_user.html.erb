<tr class="data-table__row">
  <td data-label="Name"><%= link_to user.full_name, user_path(user) %></td>
  <td data-label="Email" class="data-table__muted data-table__wide"><%= user.email %></td>
  <td data-label="Phone" class="data-table__muted"><%= f_item user.phone_number %></td>
  <td data-label="Company"><%= f_item user.company&.name %></td>
  <td class="data-table__actions">
    <%= link_to "Edit", edit_user_path(user), class: "btn btn--light", aria: { label: "Edit #{user.full_name}" } %>
    <%= button_to "Delete", user_path(user), method: :delete, class: "btn btn--quiet",
                  aria: { label: "Delete #{user.full_name}" },
                  form: { data: { turbo_confirm: "Delete #{user.full_name}?" } } %>
  </td>
</tr>
