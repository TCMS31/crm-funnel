<% content_for :title, "Contacts — CRM Funnel" %>
<main class="container">
  <%= link_to sanitize("&larr; Back to funnel"), root_path, class: "breadcrumb" %>

  <div class="header">
    <div>
      <h1>Contacts</h1>
      <p class="header__subtitle">
        <%= number_with_delimiter @users.total_count %> contacts ·
        page <%= @users.current_page %> of <%= @users.total_pages %>
      </p>
    </div>
    <div class="header__actions">
      <%= link_to "New contact", new_user_path, class: "btn btn--primary" %>
    </div>
  </div>

  <% if @users.empty? %>
    <%= render "users/empty_state" %>
  <% else %>
    <div class="card">
      <table class="data-table data-table--users">
        <caption class="visually-hidden">Contacts, newest first</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Phone</th>
            <th scope="col">Company</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= render @users %>
        </tbody>
      </table>
    </div>
    <%= paginate @users %>
  <% end %>
</main>
