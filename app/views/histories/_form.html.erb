<%= simple_form_for deal_history, url: deal_histories_path(deal), html: { class: "deal form" } do |f| %>
  <%= form_error_notification(deal_history) %>
  <%= f.input :stage, as: :select, collection: DealHistory.stage_names,
              include_blank: false, label: "New stage", input_html: { autofocus: true } %>
  <div class="header__actions">
    <%= link_to "Cancel", deal_path(deal), class: "btn btn--light" %>
    <%= f.submit "Record stage", class: "btn btn--secondary" %>
  </div>
<% end %>
