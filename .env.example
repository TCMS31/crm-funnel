# Copy to .env for local development. dotenv-rails loads it automatically.
# Nothing here is a secret in development; in production these come from the
# platform's own environment, never from a committed file.

# --- Database (standard libpq variables) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=crm_funnel_development
PGDATABASE_TEST=crm_funnel_test

# --- Rails ---
RAILS_MAX_THREADS=5
PORT=3000
# Required in production only; generate with `bin/rails secret`.
# SECRET_KEY_BASE=
# Set to any value to let Rails serve /public itself (Docker image does this).
# RAILS_SERVE_STATIC_FILES=true

# --- Import ---
# Path to the contact export loaded by `bin/rails db:seed`.
CRM_IMPORT_CSV=crm_data.csv
